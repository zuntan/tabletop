{
  "name": "tabletop",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run locales:check && npm run licenses && tsc --noEmit && vite build",
    "start": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx --test tests/*.e2e.ts",
    "licenses": "node scripts/generate-licenses.mjs",
    "locales:check": "node --import tsx scripts/check-locales.ts",
    "build:pages": "npm run locales:check && npm run licenses && tsc --noEmit && vite build --mode pages && node scripts/prepare-pages.mjs",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/hashes": "2.4.0",
    "@simonwep/pickr": "1.10.2",
    "d3-interpolate": "3.0.1",
    "fflate": "^0.8.3",
    "i18next": "26.7.1",
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0",
    "open": "11.0.4",
    "qrcode": "1.5.4",
    "ws": "^8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/d3-interpolate": "3.0.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/ws": "^8.18.1",
    "playwright": "^1.58.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
